# 本地开发环境变量。
#
# 用法：cp .env.example .env，按需改端口。.env 已被 gitignore，不会进仓库。
#
# ★ 这个文件只放【本地开发】的配置。真实密钥永远不进 git ——
#   pre-commit 有密钥扫描闸门，密钥进了历史就得去供应商侧轮换。

# ---------- docker compose 的宿主机端口 ----------
# 撞车时改这里。常见的撞车来源：
#   5432  brew 装的 postgresql（绑 127.0.0.1，会抢在 docker 前面被 localhost 命中）
#   5433  其他项目的 compose
#   6379  brew 装的 redis
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
REDIS_PORT=6379

# ---------- 后端 ----------
# 端口改了之后，这里的 DB_URL 要跟着改
DB_URL=jdbc:postgresql://localhost:5432/mfg
DB_USERNAME=mfg
DB_PASSWORD=mfg

REDIS_HOST=localhost
REDIS_PORT_APP=6379

# ★ 必填，且至少 32 字节（HS256 要求 256 bit）。启动时校验，太短直接起不来。
#   本地随便填，生产走 Secret Manager —— 绝不共用同一个值。
#   生成：openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-please-change-me-0123456789abcdef

# ---------- 对象存储 ----------
# 本地开发用 memory 实现，不打真实对象存储。
# 要打真桶（Sealos OSS，S3 兼容）就把 provider 改成 s3 并填下面几项；
# 本地用 External 端点，线上容器用 Internal 端点（由 GitHub Variables/Secrets 覆盖，见 deploy/README.md）。
# ★ SECRET_KEY 只在 .env 里填，绝不进 git —— pre-commit 的密钥扫描会拦。
STORAGE_PROVIDER=memory
STORAGE_S3_ENDPOINT=https://objectstorageapi.bja.sealos.run
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=aprx7mvw-yuhao-oss
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# 没有种子账号开关。客户端走 /auth/register 自助注册，供应商走邀请，
# 运营账号目前没有创建入口 —— 详见 README「开发登录」。

# ---------- AI（Spring AI → Sealos aiproxy，OpenAI 兼容）----------
# ★ key 只填这里，绝不进 git。没配时 AI 调用会失败，但应用能启动。
SEALOS_AI_BASE_URL=https://aiproxy.bja.sealos.run
SEALOS_AI_MODEL=deepseek-chat
SEALOS_AI_API_KEY=
